# ========================================================================
# VARIABLES DE ENTORNO - BACKEND (PLANTILLA SEGURA)
# ========================================================================
# Copia este archivo como backend/.env y configura tus credenciales reales.
# En Vercel, configura estas variables en Settings > Environment Variables.
# NUNCA incluyas llaves ni contraseñas reales en archivos versionados.

# Supabase (OBLIGATORIO - el servidor fallará al iniciar si faltan)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación JWT (OBLIGATORIO - usa una cadena aleatoria de al menos 32 caracteres)
JWT_SECRET=

# Configuración del servidor y CORS
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# Correo electrónico SMTP (Gmail con Contraseña de Aplicación de 16 caracteres)
EMAIL_USER=
EMAIL_PASS=

# Nivel de logs
LOG_LEVEL=info
